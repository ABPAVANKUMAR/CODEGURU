* {
  box-sizing: border-box;
}

:root {
  --bg: #f3f7ff;
  --panel: #ffffff;
  --panel-soft: #eef4ff;
  --primary: #4f46e5;
  --primary-strong: #312e81;
  --accent: #8b5cf6;
  --border: #dfe8ff;
  --text: #1f2937;
  --muted: #6b7280;
  --shadow: 0 18px 40px rgba(79, 70, 229, 0.12);
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  font-family: 'Inter', sans-serif;
  background: var(--bg);
  color: var(--text);
}

button, select, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 280px;
  background: white;
  border-right: 1px solid var(--border);
  padding: 24px 18px;
  box-shadow: var(--shadow);
}

.brand-box {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 10px;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(79,70,229,0.08), rgba(139,92,246,0.09));
  margin-bottom: 24px;
}

.brand-mark {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  color: white;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  font-weight: 800;
}

.brand-name {
  font-weight: 800;
}

.brand-box small {
  color: var(--muted);
}

.nav-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nav-item {
  border: none;
  background: transparent;
  color: var(--text);
  text-align: left;
  border-radius: 12px;
  padding: 12px 14px;
  font-weight: 600;
}

.nav-item.active {
  background: linear-gradient(135deg, rgba(79,70,229,0.08), rgba(139,92,246,0.06));
  color: var(--primary-strong);
  border: 1px solid rgba(79,70,229,0.15);
}

.main-panel {
  flex: 1;
  padding: 26px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.topbar h1 {
  margin: 0;
  font-size: 2rem;
}

.topbar small {
  color: var(--muted);
}

.header-actions {
  display: flex;
  gap: 10px;
}

.panel {
  background: white;
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 22px;
  margin-bottom: 20px;
  box-shadow: var(--shadow);
}

.hero-block {
  padding: 24px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(79,70,229,0.06), rgba(139,92,246,0.06));
  margin-bottom: 22px;
}

.eyebrow {
  display: inline-block;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--primary);
}

.hero-block h2 {
  margin: 12px 0 10px;
  font-size: 2.3rem;
}

.hero-block p {
  margin: 0;
  max-width: 760px;
  color: var(--muted);
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
}

.stat-card {
  background: var(--panel-soft);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.stat-card strong {
  font-size: 1.8rem;
}

.stat-card span {
  color: var(--muted);
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.file-tabs {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.tab, .button-like, .editor-actions button {
  border: 1px solid var(--border);
  background: white;
  color: var(--text);
  border-radius: 10px;
  padding: 8px 12px;
}

.tab.active {
  background: rgba(79, 70, 229, 0.08);
  border-color: rgba(79, 70, 229, 0.2);
  color: var(--primary-strong);
}

.editor-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

select, textarea {
  border: 1px solid var(--border);
  background: white;
  border-radius: 10px;
  padding: 9px 12px;
  color: var(--text);
}

textarea {
  width: 100%;
  min-height: 120px;
  resize: vertical;
}

.primary, .secondary {
  border: none;
  border-radius: 10px;
  padding: 10px 14px;
  font-weight: 600;
}

.primary {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: white;
}

.secondary {
  background: rgba(79, 70, 229, 0.08);
  color: var(--primary-strong);
}

.editor-wrap {
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
}

.input-output-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
  margin-top: 16px;
}

.mini-panel {
  background: #f9faff;
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 14px;
}

.mini-panel h4 {
  margin-top: 0;
}

pre {
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.6;
  margin: 0;
}

.split-panel {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 20px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
}

.execution-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
}

.memory-table {
  display: grid;
  gap: 8px;
}

.memory-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1.2fr 1fr;
  gap: 12px;
  padding: 12px 10px;
  border-bottom: 1px solid var(--border);
}

.memory-row.header {
  background: rgba(79, 70, 229, 0.04);
  border-radius: 10px;
  font-weight: 700;
}

@media (max-width: 980px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid var(--border);
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
}
