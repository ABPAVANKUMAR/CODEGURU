* {
  box-sizing: border-box;
}

:root {
  --bg: #f4f7ff;
  --panel: #ffffff;
  --panel-soft: #eef4ff;
  --primary: #4f46e5;
  --primary-strong: #312e81;
  --accent: #8b5cf6;
  --border: #dfe7ff;
  --text: #1f2937;
  --muted: #6b7280;
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;
  --shadow: 0 15px 40px rgba(79, 70, 229, 0.12);
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: 'Inter', sans-serif;
}

body {
  min-height: 100vh;
}

button, select, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 290px;
  background: #ffffff;
  border-right: 1px solid var(--border);
  padding: 24px 18px;
  box-shadow: var(--shadow);
}

.brand-box {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 28px;
  padding: 12px 10px;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.1), rgba(139, 92, 246, 0.12));
}

.brand-mark {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  color: white;
  background: linear-gradient(135deg, var(--primary), var(--accent));
}

.brand-name {
  font-weight: 800;
}

.brand-box small {
  color: var(--muted);
}

nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.nav-item {
  background: transparent;
  border: none;
  text-align: left;
  padding: 12px 14px;
  border-radius: 12px;
  color: var(--text);
  font-weight: 600;
}

.nav-item.active {
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.1), rgba(139, 92, 246, 0.08));
  color: var(--primary-strong);
  border: 1px solid rgba(79, 70, 229, 0.16);
}

.main-panel {
  flex: 1;
  padding: 26px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.topbar h1 {
  margin: 0;
  font-size: 2rem;
}

.topbar small {
  color: var(--muted);
}

.header-actions {
  display: flex;
  gap: 10px;
}

.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: var(--shadow);
  padding: 22px;
  margin-bottom: 20px;
}

.hero-block {
  padding: 24px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.06), rgba(139, 92, 246, 0.05));
  margin-bottom: 22px;
}

.eyebrow {
  display: inline-block;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.72rem;
  color: var(--primary);
  font-weight: 700;
}

.hero-block h2 {
  margin: 10px 0 8px;
  font-size: 2.3rem;
}

.hero-block p {
  margin: 0;
  max-width: 760px;
  color: var(--muted);
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
}

.stat-card {
  border-radius: 16px;
  background: var(--panel-soft);
  border: 1px solid var(--border);
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.stat-card strong {
  font-size: 1.8rem;
}

.stat-card span {
  color: var(--muted);
}

.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.file-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
}

.tab, .button, .secondary, .primary, .editor-actions button, .editor-actions label {
  border: 1px solid var(--border);
  background: #ffffff;
  color: var(--text);
  border-radius: 10px;
  padding: 8px 12px;
  transition: 0.2s ease;
}

.tab.active {
  background: rgba(79, 70, 229, 0.08);
  border-color: rgba(79, 70, 229, 0.2);
  color: var(--primary-strong);
}

.editor-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

select, textarea {
  border: 1px solid var(--border);
  border-radius: 10px;
  background: white;
  padding: 9px 12px;
  color: var(--text);
}

.primary {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: white;
  border: none;
}

.secondary {
  background: rgba(79, 70, 229, 0.06);
}

.editor-wrap {
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
}

.input-output-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 16px;
  margin-top: 18px;
}

.mini-panel {
  background: #f9faff;
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 14px;
}

.mini-panel h4 {
  margin-top: 0;
}

textarea {
  width: 100%;
  min-height: 120px;
  resize: vertical;
}

.execution-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
}

pre {
  white-space: pre-wrap;
  word-break: break-word;
  margin: 0;
  line-height: 1.6;
}

.split-panel {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 22px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}

.memory-table {
  display: grid;
  gap: 8px;
}

.memory-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1.25fr 1fr;
  gap: 12px;
  padding: 12px 10px;
  border-bottom: 1px solid var(--border);
}

.memory-row.header {
  font-weight: 700;
  background: rgba(79, 70, 229, 0.04);
  border-radius: 10px;
}

@media (max-width: 980px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid var(--border);
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
}
